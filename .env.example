SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

ANTHROPIC_API_KEY=your-anthropic-key

STORAGE_BUCKET=dog-documents
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Nose biometric encoder (~380MB checkpoint).
# Baked into the Docker image at build — place the .pt at
# snoutcloud-backend/models/best_supcon_clahe_gem.pt before `docker compose build`.
#   - Local (non-Docker) dev: point NOSE_MODEL_PATH at your local .pt copy.
#   - In Docker, docker-compose sets NOSE_MODEL_PATH=/app/models/best_supcon_clahe_gem.pt.
NOSE_MODEL_PATH=../best_supcon_clahe_gem.pt

# Dev/test auth escape hatch. When set, requests with NO Bearer token fall back
# to this user_id (must exist in public.users). Lets the test client run
# auth-less before Google sign-in is wired. LEAVE EMPTY IN PRODUCTION.
DEV_AUTH_USER_ID=

# Quality gate thresholds (per nose crop). Defaults in config.py are
# production-ish (min_dim=224, sharpness=50, brightness 20-235, min_passing=6).
# Override here for permissive testing — applied on container restart, no rebuild.
QUALITY_MIN_DIM=32
QUALITY_MIN_SHARPNESS=0
QUALITY_MIN_BRIGHTNESS=1
QUALITY_MAX_BRIGHTNESS=254
QUALITY_MIN_PASSING_CROPS=1

# Duplicate-suggestion thresholds (enrollment only).
# Cosine similarity floor to surface candidates in the review screen.
# Keep low — the human tap is the safety gate, not this threshold.
DUPLICATE_SUGGEST_THRESHOLD=0.60
DUPLICATE_CANDIDATE_COUNT=5

REDIS_URL=redis://localhost:6379

# ngrok — get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-authtoken

